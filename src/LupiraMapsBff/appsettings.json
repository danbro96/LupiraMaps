{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.depz-probe": "Warning",
      "Duende": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Oidc": {
      "Authority": "https://auth.lupira.com/application/o/lupira-maps/",
      "ClientId": "lupira-maps",
      "ClientSecret": "",
      "Scopes": [
        "openid",
        "profile",
        "email",
        "groups",
        "offline_access",
        "lupira-geo-aud",
        "lupira-location-aud",
        "lupira-cal-aud",
        "lupira-contact-aud",
        "lupira-photo-aud"
      ]
    }
  },
  "DataProtection": {
    "KeyPath": "/keys"
  },
  "ReverseProxy": {
    "Clusters": {
      "geo-api": {
        "Destinations": {
          "primary": {
            "Address": "https://geo-api.lupira.com"
          }
        }
      },
      "location-api": {
        "Destinations": {
          "primary": {
            "Address": "https://location-api.lupira.com"
          }
        }
      },
      "cal-api": {
        "Destinations": {
          "primary": {
            "Address": "https://cal-api.lupira.com"
          }
        }
      },
      "contact-api": {
        "Destinations": {
          "primary": {
            "Address": "https://contact-api.lupira.com"
          }
        }
      },
      "photo-api": {
        "Destinations": {
          "primary": {
            "Address": "https://photo-api.lupira.com"
          }
        }
      }
    }
  }
}
