# The APIs and auth are same-origin via the BFF — the SPA calls them directly, so there is normally
# nothing to set here.

# Sibling apps the map links out to. Dev defaults to their Vite ports (cal 5174, maps 5175, photos 5176),
# a build to https://{cal,maps,photos}.lupira.com.
# VITE_CAL_URL=http://localhost:5174
# VITE_MAPS_URL=http://localhost:5175
# VITE_PHOTOS_URL=http://localhost:5176

# Local dev: the Vite dev server proxies /api, /auth, … to the BFF. Override its origin if not :5182.
# BACKEND_ORIGIN=http://localhost:5182
