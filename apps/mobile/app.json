{
  "expo": {
    "name": "Lupira Maps",
    "slug": "lupira-maps",
    "version": "1.0.0",
    "scheme": "lupiramaps",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "primaryColor": "#E76F51",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    },
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.lupira.maps",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "lupiramaps",
              "host": "at"
            },
            {
              "scheme": "lupiramaps",
              "host": "places"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@maplibre/maplibre-react-native",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lupira Maps shows where you are on the map.",
          "locationAlwaysAndWhenInUsePermission": "Lupira Maps records your route in the background so your movement history and photo places have no gaps.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "danbro96",
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
